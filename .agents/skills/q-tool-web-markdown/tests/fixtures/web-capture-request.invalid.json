{
  "schema_version": "1.0",
  "request_id": "",
  "owner": "",
  "operation": "capture",
  "url": "http://127.0.0.1:8080/private",
  "persistence": "working",
  "output": {
    "authorized_root": null,
    "path": "/tmp/capture.md",
    "overwrite": true,
