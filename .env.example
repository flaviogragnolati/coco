# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Better Auth Google OAuth
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/flow"

# Environment
# Derived from NODE_ENV when unset; set explicitly only to override. A production
# NODE_ENV requires APP_ENV="production" or the build fails.
APP_ENV=""
# Set by next dev / next build / next start; rarely needs a value here.
NODE_ENV=""
# Role granted to seeded development users.
DEV_USER_ROLE="user"

# Mercado Pago
# Access token from the Mercado Pago dashboard; required to enable checkout.
# Existing installations may keep MP_ACCESS_TOKEN as a server-only alias.
MERCADOPAGO_ACCESS_TOKEN=""
# Webhook signing secret; when unset, incoming webhooks cannot be verified.
# Existing installations may keep MP_WEBHOOK_TOKEN as a server-only alias.
MERCADOPAGO_WEBHOOK_SECRET=""
# Request timeout in milliseconds; the SDK default applies when unset.
MERCADOPAGO_TIMEOUT_MS=""
